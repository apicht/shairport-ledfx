# shairport-ledfx environment configuration.
# Copy to .env and fill in. Do NOT commit .env.

# Image tags. Override here to upgrade without editing compose.yml.
LEDFX_IMAGE=ghcr.io/ledfx/ledfx:v2.1.8
SHAIRPORT_IMAGE=mikebrady/shairport-sync:5.0.4
RENDER_IMAGE=bash:5.2-alpine3.22

# AirPlay receiver name. Visible in AirPlay pickers, Music Assistant, and
# Apple Home. Must be unique on your LAN.
AIRPLAY_NAME=Bathroom-Sync

# Enable shairport-sync's MQTT publisher. Set to "no" to disable entirely
# (the mqtt block is omitted from the rendered config and MQTT_HOST is not
# required). Accepts: yes/no, true/false, 1/0, on/off (case-insensitive).
MQTT_ENABLED=yes

# MQTT broker for shairport-sync to publish play_start / play_end / track
# metadata to. Used for Home Assistant automations triggered by AirPlay
# activity. shairport-sync also publishes HA-autodiscovery messages so a
# media_player entity appears in HA automatically. Required only when
# MQTT_ENABLED=yes.
#
# MQTT_HOST notes:
#   - HA Mosquitto add-on, accessed FROM the HA host: core-mosquitto
#   - HA Mosquitto add-on, accessed FROM another machine on the LAN: the HA
#     host's IP/hostname (e.g., homeassistant.local)
#   - External Mosquitto: that broker's hostname
MQTT_HOST=homeassistant.local
MQTT_PORT=1883

# Leave blank if your broker allows anonymous access. The HA Mosquitto
# add-on requires a user — create one in HA Settings → People → Users.
MQTT_USER=
MQTT_PASSWORD=

# Topic prefix override. Leave blank to use AIRPLAY_NAME as the prefix
# (e.g., "Bathroom-Sync/play_start"). Override only if you want a custom
# namespace (e.g., "lighting/bathroom").
MQTT_TOPIC=
